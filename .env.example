# Supabase project — anon key only. RLS scopes every read/write; the service
# role key belongs to trustpay-api and must never be used here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for trustpay-api's Edge Functions (auth-challenge, auth-verify).
NEXT_PUBLIC_API_URL=https://your-project.supabase.co/functions/v1

# Deployed TrustPay escrow contract (testnet) — see trustpay-contract/README.md
NEXT_PUBLIC_CONTRACT_ID=CCPOUXHJT3D7EKM44ASLS442QSNRF6IKCMIAI466FSCYMA6BWKDHHFR2

# Soroban RPC endpoint (testnet)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase — must match what the contract was deployed with.
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
